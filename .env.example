# Copy this file to .env and fill in your Supabase project credentials.
# Get these from: https://supabase.com/dashboard/project/<your-ref>/settings/api

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here
VITE_SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here
